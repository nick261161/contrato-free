# Copie este arquivo para server/.env e preencha com a connection string do Neon.
# (No dia a dia, `neon env pull` na raiz já gera .env.local — este arquivo é o fallback.)
#
#   App / API  → DATABASE_URL (pooler, hostname com -pooler)
#   Schema     → DATABASE_URL_UNPOOLED (conexão direta)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
