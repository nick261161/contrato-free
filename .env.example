# Variáveis do front (Vite). Em dia a dia use `neon env pull` / `neon deploy`,
# que geram o .env.local com DATABASE_URL, NEON_AUTH_* etc. (gitignored).

# URL da API REST local (Express em server/) — sem ela o front roda em modo mock.
VITE_API_URL=http://localhost:3001

# URL pública do Neon Auth da branch (alias VITE_* criado manualmente;
# o neon env pull só escreve NEON_AUTH_BASE_URL).
VITE_NEON_AUTH_URL=https://SEU-PROJETO.neonauth.REGION.aws.neon.tech/NOME/auth
